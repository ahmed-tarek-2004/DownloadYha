# =============================================================================
# Downloadyha API Configuration
# =============================================================================

# Server Environment (development | production | staging)
ENVIRONMENT=production

# Server Host and Port (Local / Development)
HOST=0.0.0.0
PORT=8000

# Base API Prefix (Default: /api)
API_PREFIX=/api

# Allowed CORS Origins (Comma-separated list or "*" for all)
CORS_ORIGINS=*

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# In-Memory Cache TTL in seconds for metadata extractions (Default: 300)
CACHE_TTL=300

# Rate Limiting Configuration (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Maximum Playlist Items to process in a single inspection request
MAX_PLAYLIST_ITEMS=100

# yt-dlp Extraction Socket Timeout in seconds (Default: 15)
TIMEOUT_SECONDS=15

# Custom Proxy URL for yt-dlp requests (e.g., http://user:pass@proxy.example.com:8080 or socks5://127.0.0.1:9050)
# YTDLP_PROXY=

# Custom User-Agent string for yt-dlp network requests
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
